# Copiá este archivo como .env y completá tus propios valores.
# NUNCA subas el archivo .env real al repositorio.

# --- Servidor ---
APP_PORT=4000
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=cambiar_por_una_cadena_larga_y_aleatoria

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=titan_gym

# --- Cloudinary (imágenes de las novedades, opcional) ---
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Correo para el formulario de contacto (opcional) ---
# Si SMTP_HOST está vacío, los mensajes solo se guardan en la base de datos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=contacto@titangym.example
