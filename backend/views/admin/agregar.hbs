<div class="container">
    <div class="row">
        <div class="col-12 col-md-8 col-lg-6 mx-auto">
            <h4 class="mb-3">Agregar una novedad</h4>
            {{#if error}}<div class="alert alert-danger">{{message}}</div>{{/if}}
            <form action="/admin/novedades/agregar" method="post" enctype="multipart/form-data">
                <div class="mb-3"><input type="text" class="form-control" placeholder="Título" name="titulo"></div>
                <div class="mb-3"><textarea class="form-control" placeholder="Subtítulo" name="subtitulo"></textarea></div>
                <div class="mb-3"><textarea class="form-control" rows="5" placeholder="Cuerpo (admite HTML básico)" name="cuerpo"></textarea></div>
                <div class="mb-3">
                    <label class="form-label">Categoría</label>
                    <select class="form-select" name="categoria">
                        {{#each categorias}}<option value="{{valor}}" {{#if seleccionada}}selected{{/if}}>{{valor}}</option>{{/each}}
                    </select>
                </div>
                <div class="mb-3"><label>Imagen: <input type="file" name="imagen" id="imagen"></label></div>
                <button type="submit" class="btn btn-lima">Guardar</button>
                <a href="/admin/novedades" class="btn btn-outline-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>
