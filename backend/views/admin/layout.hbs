<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Atletic Gym - Administración</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">
    <style>
        :root { --negro: #0b0b0c; --gris: #181112; --oro: #f0a22e; }
        body { background: #f3f4f6; }
        .navbar-atletic { background: var(--negro); border-bottom: 3px solid var(--oro); }
        .navbar-atletic .navbar-brand { color: #fff; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
        .navbar-atletic .navbar-brand span { color: var(--oro); }
        .navbar-atletic .nav-link { color: #d1d5db; }
        .navbar-atletic .nav-link:hover { color: var(--oro); }
        .btn-oro { background: var(--oro); border-color: var(--oro); color: var(--negro); font-weight: 700; }
        .btn-oro:hover { background: #d98a14; border-color: #d98a14; color: var(--negro); }
        .table thead { background: var(--negro); color: #fff; }
        main.admin { margin-top: 90px; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand navbar-atletic fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/admin/novedades">Atletic <span>Gym</span> · Admin</a>
            {{#if usuario}}
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="/admin/novedades">Novedades</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/contactos">Mensajes</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/login/logout">Salir <i class="fas fa-sign-out-alt"></i></a></li>
            </ul>
            {{/if}}
        </div>
    </nav>

    <main class="admin">
        {{{body}}}
    </main>
</body>
</html>
