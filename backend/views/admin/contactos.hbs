<div class="container">
    <p class="text-end text-muted">Hola {{usuario}}!</p>
    <h3 class="mb-3">Mensajes recibidos</h3>
    <div class="table-responsive bg-white shadow-sm">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th><th>Nombre</th><th>Email</th><th>Teléfono</th><th>Motivo</th><th>Plan</th><th>Mensaje</th><th>Fecha</th><th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                {{#each contactos}}
                <tr>
                    <th scope="row">{{id}}</th>
                    <td>{{nombre}}</td>
                    <td><a href="mailto:{{email}}">{{email}}</a></td>
                    <td>{{telefono}}</td>
                    <td>{{motivo}}</td>
                    <td>{{#if plan}}{{plan}}{{else}}-{{/if}}</td>
                    <td>{{mensaje}}</td>
                    <td>{{fecha fecha}}</td>
                    <td class="text-end">
                        <form method="post" action="/admin/contactos/eliminar/{{id}}" class="d-inline" onsubmit="return confirm('¿Eliminar este mensaje?')">
                            <button type="submit" title="Eliminar" class="btn btn-sm btn-danger"><i class="fa fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
                {{else}}
                <tr><td colspan="9" class="text-center text-muted p-4">Todavía no hay mensajes.</td></tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
