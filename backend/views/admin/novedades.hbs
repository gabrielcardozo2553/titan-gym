<div class="container">
    <p class="text-end text-muted">Hola {{usuario}}!</p>
    <div class="row mb-3">
        <div class="col-7"><h3>Listado de novedades</h3></div>
        <div class="col-5 text-end">
            <a class="btn btn-oro" href="/admin/novedades/agregar"><i class="fa fa-plus"></i> Nueva</a>
        </div>
    </div>
    <div class="table-responsive bg-white shadow-sm">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Imagen</th>
                    <th scope="col">Título</th>
                    <th scope="col">Categoría</th>
                    <th scope="col">Fecha</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                {{#each novedades}}
                <tr>
                    <th scope="row">{{id}}</th>
                    <td>{{{imagen}}}</td>
                    <td>{{titulo}}</td>
                    <td><span class="badge text-bg-dark">{{categoria}}</span></td>
                    <td>{{fecha}}</td>
                    <td class="text-end">
                        <a href="/admin/novedades/modificar/{{id}}" title="Editar" class="btn btn-sm btn-secondary"><i class="fa fa-pencil"></i></a>
                        <a href="/admin/novedades/eliminar/{{id}}" title="Eliminar" class="btn btn-sm btn-danger" onclick="return confirm('¿Eliminar esta novedad?')"><i class="fa fa-trash"></i></a>
                    </td>
                </tr>
                {{else}}
                <tr><td colspan="6" class="text-center text-muted p-4">Todavía no hay novedades.</td></tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
